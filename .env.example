# ============================================================
# NeuroClass — Environment Variables
# Copy this file to apps/web/.env.local for local development.
# NEVER commit .env.local to git.
# ============================================================

# ----------------------------
# Supabase (apps/web)
# Get from: supabase.com → project → settings → API
# ----------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<your-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# ----------------------------
# AI Service
# ----------------------------
CLOUD_RUN_URL=https://neuroclass-ai-<hash>-el.a.run.app

# ----------------------------
# App
# ----------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----------------------------
# AI Service (apps/ai-service/.env)
# ----------------------------
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...
GITHUB_TOKEN=ghp_...
LANGSMITH_API_KEY=ls_...
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
